# --- Required ---
MONGO_URI=mongodb://127.0.0.1:27017/internhub
JWT_SECRET=change-this-to-a-long-random-string
CLIENT_URL=http://localhost:5173

# --- Programme settings ---
PORT=5000
TIMEZONE=Asia/Kolkata
PROGRAM_START=2026-11-02
LATE_AFTER=10:00
MAX_UPLOAD_MB=20

# --- First admin account (used by `npm run seed`) ---
ADMIN_NAME=Programme Admin
ADMIN_EMAIL=admin@internhub.local
ADMIN_PASSWORD=Admin@12345

# --- Google Meet (optional; see README "Google Meet setup") ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
